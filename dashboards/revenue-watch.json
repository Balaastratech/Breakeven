      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((max by (channel) (ad_slot_failed_breaks_streak) >= bool 1) * on(channel) group_left() sum by (channel) (stream_concurrent_viewers))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
