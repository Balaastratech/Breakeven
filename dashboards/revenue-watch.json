{
  "uid": "breakeven-revenue-watch",
  "title": "BreakEven Revenue Watch",
  "description": "Executive incident overview: current revenue exposure, affected audience, and the operational signals that explain it.",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Revenue at risk now",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((max by (channel) (ad_slot_failure_ratio)) * on(channel) (max by (channel) (ad_slot_failed_breaks_streak) >= bool 1)) * on(channel) group_left() sum by (channel) (stream_concurrent_viewers) * on(channel) group_left() (channel_breaks_per_hour / 60) * on(channel) group_left() channel_ads_per_break * on(channel) group_left() (max by (channel) (channel_cpm_usd) / 1000))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      }
    },
