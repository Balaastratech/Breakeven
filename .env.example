# Vertex AI (required by the agent)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=breakeven-pnl-agent
GOOGLE_CLOUD_LOCATION=us-central1

# Local service endpoints
BREAKEVEN_SIM_URL=http://127.0.0.1:8080
BREAKEVEN_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
BREAKEVEN_TEMPO_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
BREAKEVEN_CONSOLE_URL=http://127.0.0.1:8081

# Optional local simulator remote-write switch
BREAKEVEN_ALLOW_LOCAL_METRICS_WRITE=1

# Optional escalation email
BREAKEVEN_SMTP_HOST=smtp.gmail.com
BREAKEVEN_SMTP_PORT=587
BREAKEVEN_SMTP_FROM=
BREAKEVEN_SMTP_TO=
BREAKEVEN_SMTP_PASSWORD=

# Cloud Run supplies PORT automatically; leave unset for local defaults.
# PORT=8080
